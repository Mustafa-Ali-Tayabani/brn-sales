# Copy to .env (never committed). The app reads it on start; real environment variables win.

# Your Hostinger mailbox: the agent sends from it and reads replies from it into the Mailbox page.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=sales@yourdomain.com
SMTP_PASSWORD=
IMAP_HOST=imap.hostinger.com
# IMAP_LOOKBACK_DAYS=14        # how far back replies are pulled in

# ANTHROPIC_API_KEY=           # Claude writes emails and classifies replies (built-in templates without it)
# RESEND_API_KEY=              # send through Resend instead of SMTP (wins when set)
# APOLLO_API_KEY=              # contact finder: name + LinkedIn link -> work email and phone (Apollo.io)
# GOOGLE_PLACES_API_KEY=       # lead discovery from Google Maps: enable "Places API (New)"
# VAPI_API_KEY=                # AI phone calls, with VAPI_PHONE_NUMBER_ID and VAPI_ASSISTANT_ID
# VAPI_PHONE_NUMBER_ID=
# VAPI_ASSISTANT_ID=
# BRN_ALLOW_LIVE=1             # unlocks Live send mode
# BRN_ADMIN_PASSWORD=          # password-protects the dashboard. Required on a public server to open the Mailbox folders
